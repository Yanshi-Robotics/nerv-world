# Agent working notes (local only — not part of the open-source repo).
# ⛔ AGENTS.md is NOT here on purpose: it is the public, machine-facing entry point and is tracked.
CLAUDE.md
.claude/

__pycache__/
*.pyc
.venv/
.DS_Store

# ⛔ build/ is NOT ignored: <scene>-<robot>.xml in there are this repo's deliverables
#    (consumers read them directly), not a build cache. Many people's global gitignore
#    lists build/, and a repo-local .gitignore outranks core.excludesFile — hence the
#    explicit un-ignore below. Only the renderer's temp probe is excluded.
!/build/
!/build/**
/build/_docs_probe.xml

# Scratch + stray runtime log.
# ⚠️ MUJOCO_LOG.TXT deliberately has no leading slash: MuJoCo writes it to the *current
#    working directory*, so it can land anywhere depending on where you ran the script.
temp/
MUJOCO_LOG.TXT
node_modules/
.pytest_cache/
decor/assets/
# 上游原始压缩包与 GeoJSON 缓存（RoboCasa zip 有 135 MB）——只是下载中转，不入库
.cache/

# 给 Jeff 看图的中转夹（正本在工作区根，见全局 CLAUDE.md）——绝不入库
临时图片拷贝版本/
